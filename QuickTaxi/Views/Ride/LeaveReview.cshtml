@model QuickTaxi.Models.Review

@{
    ViewData["Title"] = "Laisser un avis";
}

<h2>Laisser un avis</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-action="LeaveReview" asp-controller="Ride" method="post">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning">
            <strong>Erreurs de validation :</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @Html.HiddenFor(model => model.RideId)

    <div class="form-group">
        <label for="Rating">Note (1 à 5)</label>
        @Html.TextBoxFor(model => model.Rating, new { @class = "form-control", type = "number", min = "1", max = "5" })
        @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="Comment">Commentaire</label>
        @Html.TextAreaFor(model => model.Comment, new { @class = "form-control", rows = "4" })
        @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Envoyer l'évaluation</button>
</form>
